# ==============================================================================
# DueDesk Compliance Tracker - Environment Configuration Template
# Names and structure only. Never commit secrets to version control.
# ==============================================================================

# Database (Neon Serverless Postgres)
DATABASE_URL=postgresql://USER:PASSWORD@YOUR_NEON_HOST/finance_app?sslmode=require

# Authentication (Better Auth)
BETTER_AUTH_SECRET=your-random-32-character-better-auth-secret
BETTER_AUTH_URL=http://localhost:4000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001

# Transactional Email (Resend)
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=DueDesk <notifications@yourdomain.com>

# Social Authentication Providers (OAuth)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret

# Object Storage (Cloudflare R2 Document Vault)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=duedesk-documents

# Payments & Billing (Razorpay)
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Application URLs
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
