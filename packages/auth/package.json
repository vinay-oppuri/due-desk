{
  "name": "@repo/auth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./server": {
      "types": "./src/server.ts",
      "default": "./dist/server.js"
    },
    "./client": {
      "types": "./src/client.ts",
      "default": "./dist/client.js"
    },
    "./roles": {
      "types": "./src/roles.ts",
      "default": "./dist/roles.js"
    },
    "./email": {
      "types": "./src/email.ts",
      "default": "./dist/email.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check-types": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.7",
    "@repo/db": "workspace:*",
    "@repo/env": "workspace:*",
    "better-auth": "^1.7.7",
    "resend": "^6.32.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^24.0.0"
  }
}